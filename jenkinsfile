pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/BPavithra147/javaApp.git'
            }
        }

        stage('Compile') {
            steps {
                bat '''
                set "PATH=C:\\Program Files\\Apache\\apache-maven-3.9.16\\bin;%PATH%"
                mvn compile
                '''
            }
        }

        stage('Test') {
            steps {
                bat '''
                set "PATH=C:\\Program Files\\Apache\\apache-maven-3.9.16\\bin;%PATH%"
                mvn test
                '''
            }
        }

        stage('Package') {
            steps {
                bat '''
                set "PATH=C:\\Program Files\\Apache\\apache-maven-3.9.16\\bin;%PATH%"
                mvn package
                '''
            }
        }
    }
}